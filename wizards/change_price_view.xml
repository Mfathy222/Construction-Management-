<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="change_price_wizard" model="ir.ui.view">
        <field name="name">Change Price</field>
        <field name="model">work.item.change.price</field>
        <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="quantity" string="Remaining Quantity"/>
                                <field name="origin_id" invisible="1"/>
                                <field name="change_reason" required="True"/>
                                <field name="old_price" invisible="1"/>

                            </group>
                            <group>
                                <field name="uom"/>
                                <field name="change_price_date" string="Changing Date" required="True"/>
                                <field name="price_unit" string="New Price"/>
                                <field name="contract_id" invisible="1"/>
                            </group>
                        </group>
                        <footer>
                            <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                            <button string="Cancel" special="cancel" class="btn-secondary"/>
                        </footer>
                    </sheet>
                </form>
        </field>
    </record>

    <record id="action_change_price" model="ir.actions.act_window">
        <field name="name">Change Price</field>
        <field name="res_model">work.item.change.price</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>
</odoo>