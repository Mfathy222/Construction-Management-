<odoo>
<record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.construction</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
         <xpath expr="//app[@name='general_settings']" position="after">
                <app data-string="Construction"
                     string="Construction"
                     name="construction_settings"
                     logo="/construction/static/description/icon.png">
                    <h2>Accounting</h2>
                   <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Retention Accounts</span>
                                <div class="text-muted">
                                    Configure receivable and payable accounts for retention
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="retention_receivable_account" string="Receivable" class="col-lg-4 o_light_label"/>
                                        <field name="retention_receivable_account" class="col-lg-8"
                                               domain="[('account_type','=','asset_current')]"
                                               context="{'default_account_type':'asset_current','default_reconcile':True}"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="retention_payable_account" string="Payable" class="col-lg-4 o_light_label"/>
                                        <field name="retention_payable_account" class="col-lg-8"
                                               domain="[('account_type','=','liability_current')]"
                                               context="{'default_account_type':'liability_current','default_reconcile':True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                       <div class="col-12 col-lg-6 o_setting_box">
                           <div class="o_setting_right_pane">
                               <span class="o_form_label">Down Payment Accounts</span>
                               <div class="text-muted">
                                   Configure deferred expenses and deferred revenues accounts
                               </div>
                               <div class="content-group">
                                   <div class="row mt16">
                                       <label for="deferred_expense_account" string="Deferred Expense" class="col-lg-4 o_light_label"/>
                                       <field name="deferred_expense_account" class="col-lg-8"
                                              domain="[('account_type','=','asset_current')]"
                                              context="{'default_account_type':'asset_current','default_reconcile':True}"/>
                                   </div>
                                   <div class="row mt8">
                                        <label for="deferred_revenue_account" string="Deferred Revenue" class="col-lg-4 o_light_label"/>
                                        <field name="deferred_revenue_account" class="col-lg-8"
                                               domain="[('account_type','=','liability_current')]"
                                               context="{'default_account_type':'liability_current','default_reconcile':True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <h2>Work Progress</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="enable_exceed_contract_value"/>
                                <div class="text-muted">
                                    Allow exceeding the agreed contract amount
                                </div>
                                <field name="enable_exceed_contract_value" string="Exceed Contract Value"/>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
    </field>
</record>



<record id="action_construction_config_settings" model="ir.actions.act_window">
    <field name="name">Settings</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.config.settings</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
    <field name="context">{'module' : 'construction_settings'}</field>
</record>



<menuitem id="construction_menu_root_configuration_settings"
          name="Settings"
          parent="construction_menu_root_configuration"
          action="action_construction_config_settings"
          sequence="1"/>
</odoo>